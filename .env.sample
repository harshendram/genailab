# EmailMaster CLI Environment Variables

# ---- AI provider -------------------------------------------------------
# Azure OpenAI is used when AZURE_OPENAI_API_KEY is set; otherwise Gemini.
# Force one with AI_PROVIDER=azure or AI_PROVIDER=gemini.

# Option 1: Azure OpenAI (Azure portal / AI Foundry -> your resource -> Keys and Endpoint)
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
# Deployment to use (default: gpt-5.4-mini). Or: emailmaster config --model <name>
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Option 2: Google Gemini (https://aistudio.google.com/ -> Get API key)
# Model is set with: emailmaster config --model <name> (default: gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Set custom batch size for processing emails (default: 5)
BATCH_SIZE=5

# Optional: Enable debug mode (default: false)
DEBUG=false

# Note: Gmail API credentials should be placed in credentials.json file
# Download from Google Cloud Console: https://console.cloud.google.com/
